# NVIDIA API Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Default Models
DEFAULT_PLANNER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
DEFAULT_CODER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
DEFAULT_VERIFIER_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# App Settings
WORKSPACE_ROOT=.
MAX_CONCURRENT_GOALS=5
MAX_TOKENS_PER_GOAL=50000
AUTO_APPROVE_READONLY=true
